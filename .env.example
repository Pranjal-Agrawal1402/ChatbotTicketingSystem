# ---------- Core ----------
SECRET_KEY=change-this-to-a-long-random-string
SITE_NAME=Heritage UP — Smart Museum Experience
CURRENCY=inr

# ---------- Database ----------
# Uses a local SQLite file at instance/museum.db by default — zero setup.
# Override only if you mount a persistent volume on your host (e.g. a
# Render disk or Fly.io volume) and want the DB stored there instead:
# DB_PATH=/data/museum.db
DB_PATH=

# ---------- Admin panel ----------
# Access it any time via the small gear icon in the bottom-left corner of
# the site, or directly at /admin/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- AI Chatbot (Google Gemini) ----------
# Get a free key at https://aistudio.google.com/app/apikey
# If left blank, the chatbot automatically falls back to a smart
# rule-based engine that still answers from the live museum database.
GEMINI_API_KEY=

# ---------- Payment Gateway (Stripe) ----------
# Get test keys at https://dashboard.stripe.com/test/apikeys
# If left blank, bookings automatically use a built-in DEMO payment mode
# so the whole flow (booking, receipt, admin dashboard) works instantly.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
